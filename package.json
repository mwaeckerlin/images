{
  "name": "mwaeckerlin",
  "version": "1.0.0",
  "description": "Base Monorepo for Marc Wäckerlin",
  "workspaces": [
    "./allow-write-access",
    "./bind",
    "./build",
    "./cron",
    "./dockindock",
    "./fake-smtp",
    "./hermes",
    "./langgraph-agent",
    "./lizardfs-client",
    "./maestro",
    "./mailservice",
    "./mcp-gitea",
    "./mcp-github",
    "./nextcloud",
    "./nginx",
    "./nodejs",
    "./nodejs-build",
    "./openclaw",
    "./openclaw-mcp-gateway",
    "./parliament-winterthur-tool",
    "./php-fpm",
    "./python",
    "./python-build",
    "./redis",
    "./reverse-proxy",
    "./rsync",
    "./scratch",
    "./ubuntu-base",
    "./ubuntu-scratch",
    "./ubuntu-very-base",
    "./very-base",
    "./vscode",
    "./wordpress"
  ],
  "scripts": {
    "build": "bash -c 'LOG=$(mktemp); npm run build --workspaces --if-present --foreground-scripts --bail 2>&1 | tee \"$LOG\"; RC=${PIPESTATUS[0]}; [ \"$RC\" != 0 ] && echo && echo === ERROR === && grep -E \"ERROR|failed to solve\" \"$LOG\" | tail -20; rm -f \"$LOG\"; exit \"$RC\"'",
    "test": "npm run test --workspaces --if-present",
    "test:image": "npm run test:image --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "start:dev": "npm run start:dev --workspaces --if-present",
    "stop": "npm run stop --workspaces --if-present"
  }
}